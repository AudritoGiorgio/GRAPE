<style is:global>
  .copy-wrap { position: relative; }
  .copy-btn { position: absolute; top: 8px; right: 8px; padding: 4px 10px; font: 600 12px/1.4 'Red Hat Text', sans-serif;
    background: #FFFFFF; color: #1E2220; border: 1px solid #D6DAD3; cursor: pointer; opacity: .85; transition: opacity .15s, background .15s; }
  .copy-btn:hover, .copy-btn:focus-visible { opacity: 1; border-color: #1E2220; }
  .copy-btn.is-done { background: #4B2D6E; border-color: #4B2D6E; color: #fff; opacity: 1; }
  .copy-wrap.is-dark .copy-btn { background: #2C312E; color: #fff; border-color: #4A504C; }
  .copy-wrap.is-dark .copy-btn.is-done { background: #4B2D6E; border-color: #4B2D6E; }
  .copy-wrap pre { padding-right: 76px; }
</style>
<script>
  // A Copy button in the top-right corner of every <pre> on the page.
  for (const pre of Array.from(document.querySelectorAll<HTMLPreElement>('pre'))) {
    const wrap = document.createElement('div');
    wrap.className = 'copy-wrap' + (pre.classList.contains('bg-ink') ? ' is-dark' : '');
    pre.parentNode!.insertBefore(wrap, pre);
    wrap.appendChild(pre);
    wrap.style.marginTop = getComputedStyle(pre).marginTop; pre.style.marginTop = '0';
    const btn = document.createElement('button');
    btn.type = 'button'; btn.className = 'copy-btn'; btn.textContent = 'Copy';
    btn.setAttribute('aria-label', 'Copy to clipboard');
    let t = 0;
    btn.addEventListener('click', async () => {
      const text = pre.textContent ?? '';
      try { await navigator.clipboard.writeText(text); }
      catch {
        const ta = document.createElement('textarea'); ta.value = text; ta.style.position = 'fixed'; ta.style.opacity = '0';
        document.body.appendChild(ta); ta.select(); document.execCommand('copy'); ta.remove();
      }
      btn.textContent = 'Copied!'; btn.classList.add('is-done');
      clearTimeout(t); t = window.setTimeout(() => { btn.textContent = 'Copy'; btn.classList.remove('is-done'); }, 1800);
    });
    wrap.appendChild(btn);
  }
</script>
