---
import { datasets } from '../data/datasets';
---
<section id="datasets" class="py-24 md:py-36">
  <div class="wrap">
    <p class="kicker">The data</p>
    <h2 class="h2 mt-4">Three datasets, one season</h2>
    <p class="mt-5 max-w-[62ch] text-[17px] leading-relaxed text-muted">All three are open on Zenodo under CC BY 4.0. The training and evaluation code is on GitHub under the MIT licence.</p>
    <p class="mt-10 font-mono text-[13px] text-muted">Select a dataset to inspect its folder schema and quick start below.</p>
    <div class="mt-4 grid border-t border-ink md:grid-cols-3" role="tablist" aria-label="Datasets">
      {datasets.map((d, i) => (
        <article class={`ds-col group relative flex min-w-0 cursor-pointer flex-col gap-5 border-line px-5 py-7 transition-colors md:px-7 ${i > 0 ? 'border-t md:border-l md:border-t-0' : ''} ${i === 0 ? 'is-on' : ''}`} data-i={i}>
          <span class="ds-bar absolute inset-x-0 -top-px h-[5px] bg-accent"></span>
          <h3 class="font-display text-[28px] font-bold leading-none tracking-head">{d.name}</h3>
          <p class="min-h-[3em] text-[15px] leading-relaxed text-muted">{d.role}</p>
          <dl class="grid grid-cols-[auto_1fr] gap-x-6 gap-y-2 text-[14px]">
            {d.specs.map(([k, v]) => (<><dt class="text-muted">{k}</dt><dd class="tabular text-right font-medium">{v}</dd></>))}
          </dl>
          <div class="mt-auto flex flex-wrap items-center justify-between gap-x-6 gap-y-4 pt-2">
            <a class="ds-doi lnk text-[14px]" href={`https://doi.org/${d.doi}`} target="_blank" rel="noopener">Open on Zenodo ↗</a>
          </div>
          <button type="button" role="tab" id={`ds-tab-${d.id}`} class="ds-toggle flex w-full items-center justify-between border border-ink px-4 py-3 text-left text-[14px] font-semibold transition-colors" aria-selected={i === 0 ? 'true' : 'false'} aria-controls={`ds-panel-${d.id}`} tabindex={i === 0 ? 0 : -1}>
            <span>Inspect schema &amp; quickstart</span><span class="ds-arrow" aria-hidden="true">↓</span>
          </button>
        </article>
      ))}
    </div>
    {datasets.map((d, i) => (
      <div id={`ds-panel-${d.id}`} role="tabpanel" aria-labelledby={`ds-tab-${d.id}`} class="ds-panel scroll-mt-20 border-t-[3px] border-accent bg-alt px-5 py-8 md:px-8" hidden={i !== 0}>
        <p class="font-mono text-[13px] text-accent">{d.name} · schema &amp; quick start</p>
        <div class="mt-6 grid gap-10 md:grid-cols-2">
          <div class="min-w-0">
            <h4 class="text-[13px] font-semibold text-muted">{d.treeTitle}</h4>
            <pre class="mt-3 overflow-x-auto border-l-2 border-ink bg-ground p-4 font-mono text-[13px] leading-relaxed">{d.tree}</pre>
          </div>
          <div class="grid min-w-0 content-start gap-6">
            <div><h4 class="text-[13px] font-semibold text-muted">What is inside</h4>
              <ul class="mt-3 list-disc space-y-1 pl-5 text-[15px] text-muted">{d.notes.map((n) => <li>{n}</li>)}</ul></div>
            <div><h4 class="text-[13px] font-semibold text-muted">Quick start</h4>
              <pre class="mt-3 overflow-x-auto border-l-2 border-ink bg-ground p-4 font-mono text-[13px] leading-relaxed">{d.code}</pre></div>
            <p class="font-mono text-[12px] text-muted">doi.org/{d.doi}</p>
          </div>
        </div>
      </div>
    ))}
  </div>
</section>
<style>
  .ds-bar { opacity: 0; transition: opacity .2s; }
  .ds-col:hover { background: #F7F8F5; }
  .ds-col.is-on { background: #EEE9F3; }
  .ds-col.is-on .ds-bar { opacity: 1; }
  .ds-col.is-on .ds-toggle { background: #4B2D6E; border-color: #4B2D6E; color: #fff; }
  .ds-col:not(.is-on) .ds-toggle:hover { background: #1E2220; color: #fff; }
  .ds-col.is-on::after { content: ''; position: absolute; left: 50%; bottom: -1px; width: 18px; height: 10px; transform: translateX(-50%); background: #4B2D6E; clip-path: polygon(0 100%, 50% 0, 100% 100%); }
  @media (max-width: 767px) { .ds-col.is-on::after { display: none; } }
</style>
<script>
  const cols = Array.from(document.querySelectorAll<HTMLElement>('.ds-col'));
  const tabs = cols.map((c) => c.querySelector<HTMLButtonElement>('.ds-toggle')!);
  const panels = Array.from(document.querySelectorAll<HTMLElement>('.ds-panel'));
  const mobile = matchMedia('(max-width: 767px)');
  function show(i: number, focus = false) {
    cols.forEach((c, k) => {
      const on = k === i;
      c.classList.toggle('is-on', on);
      tabs[k].setAttribute('aria-selected', String(on));
      tabs[k].tabIndex = on ? 0 : -1;
    });
    panels.forEach((p, k) => { p.hidden = k !== i; });
    if (focus) tabs[i].focus();
    // on phones the panel sits after all three cards: bring it into view
    if (mobile.matches) panels[i].scrollIntoView({ behavior: 'smooth', block: 'start' });
  }
  cols.forEach((c, i) => c.addEventListener('click', (e) => {
    if ((e.target as HTMLElement).closest('a')) return;
    show(i);
  }));
  tabs.forEach((t, i) => t.addEventListener('keydown', (e) => {
    const d = e.key === 'ArrowRight' ? 1 : e.key === 'ArrowLeft' ? -1 : 0;
    if (d) { e.preventDefault(); show((i + d + tabs.length) % tabs.length, true); }
  }));
</script>
