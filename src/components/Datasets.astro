---
import { datasets } from '../data/datasets';
---
<section id="datasets" class="py-24 md:py-36">
  <div class="wrap">
    <p class="kicker">The data</p>
    <h2 class="h2 mt-4">Three datasets, one season</h2>
    <p class="mt-5 max-w-[62ch] text-[17px] leading-relaxed text-muted">All three are open on Zenodo under CC BY 4.0. The training and evaluation code is on GitHub under the MIT licence.</p>
    <div class="mt-12 grid border-t border-ink md:grid-cols-3">
      {datasets.map((d, i) => (
        <article class={`ds-col relative flex min-w-0 flex-col gap-5 border-line py-7 md:px-7 ${i === 0 ? 'md:pl-0' : 'md:border-l'} ${i > 0 ? 'border-t md:border-t-0' : ''}`} data-i={i}>
          <span class={`ds-bar absolute inset-x-0 -top-px h-1 bg-accent ${i === 0 ? '' : 'hidden'}`}></span>
          <h3 class="font-display text-[28px] font-bold leading-none tracking-head">{d.name}</h3>
          <p class="min-h-[3em] text-[15px] leading-relaxed text-muted">{d.role}</p>
          <dl class="grid grid-cols-[auto_1fr] gap-x-6 gap-y-2 text-[14px]">
            {d.specs.map(([k, v]) => (<><dt class="text-muted">{k}</dt><dd class="tabular text-right font-medium">{v}</dd></>))}
          </dl>
          <div class="mt-auto flex flex-wrap items-center gap-6 pt-2">
            <a class="btn" href={`https://doi.org/${d.doi}`}>Zenodo DOI ↗</a>
            <button type="button" class="ds-toggle lnk" aria-expanded={i === 0 ? 'true' : 'false'} aria-controls={`ds-panel-${d.id}`}>{i === 0 ? 'Hide details' : 'Details'}</button>
          </div>
        </article>
      ))}
    </div>
    {datasets.map((d, i) => (
      <div id={`ds-panel-${d.id}`} class="ds-panel grid gap-10 border-t border-line bg-alt px-5 py-8 md:grid-cols-2 md:px-8" hidden={i !== 0}>
        <div class="min-w-0">
          <h4 class="text-[13px] font-semibold text-muted">{d.name} · {d.treeTitle}</h4>
          <pre class="mt-3 overflow-x-auto border-l-2 border-ink bg-ground p-4 font-mono text-[13px] leading-relaxed">{d.tree}</pre>
        </div>
        <div class="grid min-w-0 content-start gap-6">
          <div><h4 class="text-[13px] font-semibold text-muted">What is inside</h4>
            <ul class="mt-3 list-disc space-y-1 pl-5 text-[15px] text-muted">{d.notes.map((n) => <li>{n}</li>)}</ul></div>
          <div><h4 class="text-[13px] font-semibold text-muted">Quick start</h4>
            <pre class="mt-3 overflow-x-auto border-l-2 border-ink bg-ground p-4 font-mono text-[13px] leading-relaxed">{d.code}</pre></div>
          <p class="font-mono text-[12px] text-muted">doi.org/{d.doi}</p>
        </div>
      </div>
    ))}
  </div>
</section>
<script>
  const cols = Array.from(document.querySelectorAll<HTMLElement>('.ds-col'));
  const panels = Array.from(document.querySelectorAll<HTMLElement>('.ds-panel'));
  let open = 0;
  function show(i: number) {
    open = open === i ? -1 : i;
    cols.forEach((c, k) => {
      const on = k === open, b = c.querySelector<HTMLButtonElement>('.ds-toggle')!;
      c.querySelector('.ds-bar')!.classList.toggle('hidden', !on);
      b.setAttribute('aria-expanded', String(on)); b.textContent = on ? 'Hide details' : 'Details';
    });
    panels.forEach((p, k) => { p.hidden = k !== open; });
  }
  cols.forEach((c, i) => c.querySelector('.ds-toggle')!.addEventListener('click', () => show(i)));
</script>
