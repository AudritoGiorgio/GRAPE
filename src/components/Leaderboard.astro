---
import board from '../data/leaderboard.json';
import { renderTable, type Board } from '../lib/leaderboard';
import { links } from '../data/site';
const b = board as Board;
const keys = Object.keys(b.tasks);
const initial = renderTable(b, keys[0], links.submitResults);
---
<section id="leaderboard" class="border-t border-line py-24 md:py-36" data-submit={links.submitResults}>
  <div class="wrap">
    <p class="kicker">Benchmark</p>
    <div class="mt-4 flex flex-wrap items-end gap-x-12 gap-y-6">
      <h2 class="h2 mr-auto">Leaderboard</h2>
      <div role="tablist" aria-label="Task" class="flex flex-wrap gap-7" id="lb-tabs">
        {keys.map((k, i) => (
          <button role="tab" type="button" data-k={k} aria-selected={i === 0 ? 'true' : 'false'}
            class="border-b-2 border-transparent py-1 text-[16px] font-semibold text-muted aria-selected:border-ink aria-selected:text-ink">{b.tasks[k].label}</button>
        ))}
      </div>
    </div>
    <p class="mt-6 max-w-[70ch] text-[15px] leading-relaxed text-muted">Each method is scored on all six sessions. The session rows and the trend line show how performance moves as the grapes grow, close up and change colour from June to October.</p>
    <div class="mt-8 overflow-x-auto border-t-2 border-ink">
      <table class="tabular w-full min-w-[820px] border-collapse text-[15px]" id="lb-table" set:html={initial}></table>
    </div>
    <p class="mt-4 text-[14px] text-muted" id="lb-note">{b.tasks[keys[0]].note} Bold session values are each method&rsquo;s best. Source: GRAPE paper, Tables 5–7.</p>
  </div>
</section>
<script>
  import board from '../data/leaderboard.json';
  import { renderTable, type Board } from '../lib/leaderboard';
  const b = board as Board;
  const root = document.getElementById('leaderboard')!;
  const submit = root.dataset.submit!;
  const tabs = document.getElementById('lb-tabs')!;
  const table = document.getElementById('lb-table')!, note = document.getElementById('lb-note')!;
  let task = Object.keys(b.tasks)[0];
  let open: Set<number> = new Set(b.tasks[task].entries.map((_, i) => i));
  function draw() {
    tabs.querySelectorAll('button').forEach((x) => x.setAttribute('aria-selected', String(x.dataset.k === task)));
    table.innerHTML = renderTable(b, task, submit, open);
    note.textContent = `${b.tasks[task].note} Bold session values are each method’s best. Source: GRAPE paper, Tables 5–7.`;
  }
  tabs.addEventListener('click', (e) => {
    const x = (e.target as HTMLElement).closest('button'); if (!x) return;
    task = x.dataset.k!; open = new Set(b.tasks[task].entries.map((_, i) => i)); draw();
  });
  table.addEventListener('click', (e) => {
    const x = (e.target as HTMLElement).closest<HTMLButtonElement>('.lb-tog'); if (!x) return;
    const i = Number(x.dataset.i); open.has(i) ? open.delete(i) : open.add(i); draw();
  });
</script>
